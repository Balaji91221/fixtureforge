{
  "name": "fixtureforge",
  "version": "0.2.1",
  "description": "Deterministic stateful ticket fixture for agent tests",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "fixtureforge": "./dist/cli.js"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo": "node dist/cli.js demo",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "IMPLEMENTATION_STATUS.md",
    "PROJECT_PLAN.md",
    "examples",
    "docs",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Balaji91221/fixtureforge.git"
  },
  "homepage": "https://github.com/Balaji91221/fixtureforge#readme",
  "bugs": {
    "url": "https://github.com/Balaji91221/fixtureforge/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "fixtures",
    "testing",
    "simulation"
  ]
}
